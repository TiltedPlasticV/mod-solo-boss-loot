[worldserver]

########################################
# Solo Boss Loot
########################################
#
#    When a dungeon or raid boss (or a boss chest) is looted, the module adds that boss's own
#    loot for the real players in the group. Bots are ignored completely.
#    The normal loot roll still happens as usual; the module only ever adds items.
#
#    An item is added when it:
#      - drops only from bosses (not from trash, world-drop lists, containers, ...)
#      - is usable by a real player in the group: weapons their class can use, their main armor
#        type (plate for a level 40+ warrior), cloaks, rings, necks, trinkets, their shield or
#        relic type. Mounts, recipes, bags and other non-gear items count for everyone.
#      - matches the kill's loot mode (hard-mode loot only drops for hard modes)
#      - isn't already learned (recipes, mounts, pets) or owned (see SkipOwnedItems)
#    Quest-required items are left to the normal roll.
#    If more items qualify than the 18-slot loot window has room for, a random selection is added.
#
#    Boss chests, extra bosses and per-item exceptions live in the world database table
#    `solo_boss_loot_overrides` (created by the module's data/sql/db-world SQL).
#    Settings and that table are re-read on `.reload config`.
#

#
#    SoloBossLoot.BossLoot.Enable
#        Description: Add each boss's own loot when a boss or boss chest is looted.
#        Default:     1 - Enabled
#                     0 - Disabled
#

SoloBossLoot.BossLoot.Enable = 1

#
#    SoloBossLoot.SkipOwnedItems
#        Description: Don't add items a real player already has (equipped, in bags or in the bank).
#                     Applies to boss loot and world drops.
#        Default:     1 - Enabled
#                     0 - Disabled
#

SoloBossLoot.SkipOwnedItems = 1

#
#    SoloBossLoot.SharedPoolThreshold
#        Description: An item dropped by more than this many boss loot tables is a "shared pool" item
#                     (e.g. Molten Core's recipes, dropped by 7 bosses).
#                     Shared pool items are only added if they stay in your bags: armor, weapons,
#                     bags, quivers, mounts, pets and recipes. Shared items that get used up or
#                     turned in (materials, gems, consumables, quest items, class tokens) only drop
#                     at their normal chance, otherwise they would repeat at every boss.
#                     Items unique to a boss are always added, whatever their type.
#                     Normal/heroic and 10/25-player versions of a boss count as separate loot tables.
#        Default:     3
#

SoloBossLoot.SharedPoolThreshold = 3

########################################
# World drops
########################################
#
#    When any other creature is looted (not a boss, not in a battleground or arena), the module may
#    add one of that creature's rare items at a boosted chance.
#
#    At startup the module works out how likely each item is to drop from each creature, through
#    reference tables and loot groups, using the server's Rate.Drop.Item.* settings.
#    A rare item drops less often than MaxItemChance, is at least MinQuality, and is something you
#    keep: weapons, armor, bags, quivers, recipes, mounts or pets. Quest items are never boosted.
#
#    For each creature, the rare items' chances are pulled toward each other (CompressionRatio),
#    weighted (QualityWeights, RecipeWeight) and scaled so that at least one of them drops
#    MaxCombinedChance of the time. No item drops less often than before, or more often than
#    MaxItemChance. Creatures whose rare items already drop that often are left alone.
#
#    At most one extra item is added per kill. A real player in the group who is close enough to share
#    the kill must want it, using the same checks as boss loot. Recipes also need a real player with
#    that profession. Items nobody wants don't drop, and aren't replaced by something else.
#
#    The boost is worked out from the world database, so if its drop chances were already raised by
#    hand, revert those edits first or they get boosted twice.
#

#
#    SoloBossLoot.WorldDrop.Enable
#        Description: Boost rare drops from creatures that aren't bosses.
#        Default:     1 - Enabled
#                     0 - Disabled
#

SoloBossLoot.WorldDrop.Enable = 1

#
#    SoloBossLoot.WorldDrop.MinQuality
#        Description: Lowest item quality that counts as a rare item.
#        Default:     2 - Uncommon (green)
#                     3 - Rare (blue)
#                     4 - Epic (purple)
#

SoloBossLoot.WorldDrop.MinQuality = 2

#
#    SoloBossLoot.WorldDrop.MaxItemLevel
#        Description: Only items below this item level are boosted.
#        Default:     0 - No limit
#

SoloBossLoot.WorldDrop.MaxItemLevel = 0

#
#    SoloBossLoot.WorldDrop.MaxItemChance
#        Description: Items that drop at least this often (in %) aren't boosted, and boosted items
#                     never drop more often than this.
#        Default:     5
#

SoloBossLoot.WorldDrop.MaxItemChance = 5

#
#    SoloBossLoot.WorldDrop.MaxCombinedChance
#        Description: Chance (in %) that at least one of a creature's rare items drops, after the boost.
#                     Includes the normal roll.
#        Default:     15
#

SoloBossLoot.WorldDrop.MaxCombinedChance = 15

#
#    SoloBossLoot.WorldDrop.CompressionRatio
#        Description: How far rare items' chances are pulled toward each other before they are scaled.
#                     0 keeps their relative chances, 1 gives them all the same chance.
#        Default:     0.8
#

SoloBossLoot.WorldDrop.CompressionRatio = 0.8

#
#    SoloBossLoot.WorldDrop.QualityWeights
#        Description: Weights for uncommon, rare and epic (or better) items, applied after compression.
#                     "1 3 6" makes an epic about 6 times as likely to drop as a comparable green.
#        Default:     "1 3 6"
#

SoloBossLoot.WorldDrop.QualityWeights = "1 3 6"

#
#    SoloBossLoot.WorldDrop.RecipeWeight
#        Description: Extra weight for recipes (patterns, plans, formulas, ...), multiplied with the
#                     quality weight. Below 1 makes recipes drop less often than gear.
#        Default:     0.75
#

SoloBossLoot.WorldDrop.RecipeWeight = 0.75

########################################
# Logging
########################################
#
#    Logger lines only work in worldserver.conf (put them after `Logger.module=4,Console Server`).
#    The server sets up logging before it reads module config files, so they are ignored here.
#
#    Logger.module.solo_boss_loot             Startup, settings and the loot caches
#    Logger.module.solo_boss_loot.boss        Boss kills and boss chests
#    Logger.module.solo_boss_loot.world_drop  Other creature kills
#
#    A logger you don't set uses the one above it (world_drop -> solo_boss_loot -> module).
#
#    Levels:
#        2 - Error:   bad settings or override rows
#        3 - Warning: settings out of range, override rows for things that don't exist,
#                     boss chests without loot
#        4 - Info:    loot cache summaries at startup and on .reload config
#        5 - Debug:   settings, what each boss kill added, each world drop added
#        6 - Trace:   why each item was skipped at a boss kill, world drop rolls that added nothing,
#                     one line per boss loot table at startup (many lines)
#
#    Kills without a real player in the group close by (bot kills) are never logged.
#
#    An appender only writes messages up to its own level (Appender.Name=Type,Level,...).
#
#    Example (debug for everything, trace for boss kills in its own file):
#        Appender.SoloBossLoot=2,6,7,SoloBossLoot.log,w
#        Logger.module.solo_boss_loot=5,Console SoloBossLoot
#        Logger.module.solo_boss_loot.boss=6,Console SoloBossLoot
#
